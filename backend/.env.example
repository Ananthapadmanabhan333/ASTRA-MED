# Copy to backend/.env for local runs. Every setting is optional and prefixed ASTRA_.

# SQLite works out of the box; for PostgreSQL use e.g.
# ASTRA_DATABASE_URL=postgresql+asyncpg://astra:<password>@localhost:5432/astra_med
# No PostgreSQL or Docker? `python scripts/local_postgres.py serve` runs one from pip (requirements-pg.txt).
ASTRA_DATABASE_URL=sqlite+aiosqlite:///./astra_med.db
ASTRA_HISTORY_RETENTION_DAYS=30

ASTRA_ENVIRONMENT=development
ASTRA_LOG_LEVEL=INFO
ASTRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simulator
ASTRA_SIMULATOR_ENABLED=true
ASTRA_SIMULATOR_SEED=2026
ASTRA_TICK_SECONDS=1.0
ASTRA_PERSIST_EVERY_TICKS=5
ASTRA_ECG_SAMPLE_RATE_HZ=125
ASTRA_RANDOM_EVENTS_PER_HOUR=6
ASTRA_BACKFILL_DAYS=7
ASTRA_BACKFILL_INTERVAL_MINUTES=5
ASTRA_MISSION_START_DATE=2026-06-20
ASTRA_MISSION_NAME=Helios-7
ASTRA_MISSION_PHASE=Mars transit

# Operator test-scenario controls. Disable on any shared deployment until auth exists.
ASTRA_SIMULATION_CONTROL_ENABLED=true

# AI intelligence engine (phase 3). Train first: python -m app.ai.train  (about 6 min on CPU)
ASTRA_AI_ENABLED=true
# Empty means backend/artifacts. Model versions are verified by SHA-256 before loading.
ASTRA_AI_ARTIFACTS_DIR=
ASTRA_AI_CACHE_SECONDS=30
ASTRA_AI_HISTORY_HOURS=168
