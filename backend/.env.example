# Copy to backend/.env for local runs. Every setting is optional and prefixed ASTRA_.

# SQLite works out of the box; for PostgreSQL use e.g.
# ASTRA_DATABASE_URL=postgresql+asyncpg://astra:<password>@localhost:5432/astra_med
# No PostgreSQL or Docker? `python scripts/local_postgres.py serve` runs one from pip (requirements-pg.txt).
ASTRA_DATABASE_URL=sqlite+aiosqlite:///./astra_med.db
ASTRA_HISTORY_RETENTION_DAYS=30

ASTRA_ENVIRONMENT=development
ASTRA_LOG_LEVEL=INFO
ASTRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simulator
ASTRA_SIMULATOR_ENABLED=true
ASTRA_SIMULATOR_SEED=2026
ASTRA_TICK_SECONDS=1.0
ASTRA_PERSIST_EVERY_TICKS=5
ASTRA_ECG_SAMPLE_RATE_HZ=125
ASTRA_RANDOM_EVENTS_PER_HOUR=6
ASTRA_BACKFILL_DAYS=7
ASTRA_BACKFILL_INTERVAL_MINUTES=5
ASTRA_MISSION_START_DATE=2026-06-20
ASTRA_MISSION_NAME=Helios-7
ASTRA_MISSION_PHASE=Mars transit

# Operator controls (scenarios, sync, model reload). With auth on, each also needs its permission.
ASTRA_SIMULATION_CONTROL_ENABLED=true

# Authentication and access control (phase 5). See docs/SECURITY.md.
# Create accounts with: python scripts/create_users.py add <username> --role <role>   (or `dev` locally)
ASTRA_AUTH_ENABLED=true                # false = every caller has every permission; refused in production
ASTRA_AUTH_SESSION_HOURS=8
ASTRA_AUTH_IDLE_MINUTES=60
ASTRA_AUTH_COOKIE_SECURE=false         # set true whenever the API is served over HTTPS
ASTRA_AUTH_MAX_FAILED_LOGINS=5
ASTRA_AUTH_LOCKOUT_MINUTES=15
ASTRA_AUTH_LOGIN_ATTEMPTS_PER_MINUTE=10
ASTRA_AUDIT_READ_DEDUPE_SECONDS=300

# Digital twin (phase 5): build daily summaries in the background and refresh every 5 minutes.
ASTRA_TWIN_BACKGROUND=true

# Medical data assistant (phase 5). "extractive" answers offline from cited records and passages.
# "claude" also sends the question, simulated records and passages to the Anthropic API: it needs
# ANTHROPIC_API_KEY in this environment (never in the frontend) and `pip install anthropic`.
ASTRA_ASSISTANT_MODE=extractive
ASTRA_ASSISTANT_MODEL=claude-opus-5-5
ASTRA_ASSISTANT_MAX_PASSAGES=6

# AI intelligence engine (phase 3). Train first: python -m app.ai.train  (about 6 min on CPU)
ASTRA_AI_ENABLED=true
# Empty means backend/artifacts. Model versions are verified by SHA-256 before loading.
ASTRA_AI_ARTIFACTS_DIR=
ASTRA_AI_CACHE_SECONDS=30
ASTRA_AI_HISTORY_HOURS=168

# NASA open data (phase 4). Real NASA data, kept separate from the simulated crew data.
ASTRA_SPACE_ENABLED=true
ASTRA_SPACE_SYNC_ENABLED=true          # background synchronisation with DONKI, EDA and OSDR
# Optional personal key from https://api.nasa.gov/ (free). Never commit it; never expose it to the browser.
# Empty = public DEMO_KEY (very low rate limit). DONKI fails over to the keyless CCMC service anyway.
ASTRA_NASA_API_KEY=
ASTRA_DONKI_ENDPOINTS=api.nasa.gov,ccmc  # tried in order
ASTRA_DONKI_SYNC_MINUTES=180
ASTRA_DONKI_BACKFILL_DAYS=180
ASTRA_EDA_SYNC_HOURS=168
ASTRA_EDA_MISSIONS=                    # comma-separated, e.g. RR-1,RR-3; empty = all EDA missions
ASTRA_OSDR_SYNC_HOURS=24
ASTRA_SPACE_HTTP_TIMEOUT_S=45
ASTRA_SPACE_REQUEST_SPACING_S=1.0      # politeness gap between requests to one host
