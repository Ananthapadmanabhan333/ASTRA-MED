# Copy to .env and change the password. .env is git-ignored; never commit real credentials.

# PostgreSQL (docker compose)
POSTGRES_USER=astra
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=astra_med
POSTGRES_PORT=5432

# Backend overrides (all optional; see backend/.env.example for the full list)
ASTRA_ENVIRONMENT=docker
ASTRA_LOG_LEVEL=INFO
ASTRA_CORS_ORIGINS=http://localhost:3000
ASTRA_RANDOM_EVENTS_PER_HOUR=6
ASTRA_SIMULATION_CONTROL_ENABLED=true

# Frontend (public, baked into the browser bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
