# Copy to .env and change the password. .env is git-ignored; never commit real credentials.

# PostgreSQL (docker compose)
POSTGRES_USER=astra
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=astra_med
POSTGRES_PORT=5432

# Backend overrides (all optional; see backend/.env.example for the full list)
ASTRA_ENVIRONMENT=docker
ASTRA_LOG_LEVEL=INFO
ASTRA_CORS_ORIGINS=http://localhost:3000
ASTRA_RANDOM_EVENTS_PER_HOUR=6
ASTRA_SIMULATION_CONTROL_ENABLED=true
# Sign-in and access control (phase 5). Create accounts inside the api container:
#   docker compose exec backend python scripts/create_users.py add <username> --role <role>
ASTRA_AUTH_ENABLED=true
ASTRA_AUTH_COOKIE_SECURE=false
ASTRA_ASSISTANT_MODE=extractive

# NASA open data (phase 4). Optional personal key from https://api.nasa.gov/ (free). It stays on the
# backend and is never sent to the browser. Empty uses NASA's public DEMO_KEY, which is heavily rate
# limited; DONKI then falls back to the keyless CCMC web service.
ASTRA_NASA_API_KEY=
ASTRA_SPACE_SYNC_ENABLED=true

# Frontend (public, baked into the browser bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
